# Copia este fichero a .env y ajústalo.

# Token de lectura de Hugging Face, con las condiciones de
# pyannote/speaker-diarization-community-1 aceptadas en la misma cuenta.
HOTARU_HF_TOKEN=

# Puerto del servidor donde se publica la web.
HOTARU_PORT=8080

# whisperx (real) o fake (pruebas sin modelos; con fake puedes poner HOTARU_INSTALL_ML=false).
HOTARU_ENGINE=whisperx
HOTARU_INSTALL_ML=true

# Modelo de Whisper: large-v3 (mejor), medium o small (más rápidos en CPU).
HOTARU_WHISPER_MODEL=large-v3
HOTARU_LANGUAGE=es
HOTARU_DEVICE=cpu
HOTARU_COMPUTE_TYPE=int8
HOTARU_BATCH_SIZE=8
